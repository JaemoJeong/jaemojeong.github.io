# Production is the default; mock must be selected explicitly for UI tests.
SCOPE_STREAMING_MODE=languagebind
SCOPE_REPO_PATH=/absolute/path/to/SCoPE
LANGUAGEBIND_CODE_PATH=/absolute/path/to/LanguageBind
LANGUAGEBIND_VENDOR_PATH=/absolute/path/to/pinned/vendor
LANGUAGEBIND_CACHE_DIR=/absolute/path/to/frozen/checkpoint-cache
SCOPE_LB_AUDIO_PROTOTYPES=/absolute/path/to/v25_languagebind_clap.npy
SCOPE_LB_VISUAL_PROTOTYPES=/absolute/path/to/v25_languagebind_clip.npy
SCOPE_LB_AUDIO_MEAN=/absolute/path/to/languagebind_unit_audio_llptest_inDomainMean.npy
SCOPE_LB_VISUAL_MEAN=/absolute/path/to/languagebind_unit_image_llptest_inDomainMean.npy
SCOPE_DEVICE=cuda:0
SCOPE_CORS_ORIGINS=https://jaemojeong.github.io,http://localhost:8765,http://127.0.0.1:8765
SCOPE_SESSION_TTL_SECONDS=300
SCOPE_MAX_SESSIONS=16
